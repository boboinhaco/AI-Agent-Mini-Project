---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	route(route)
	chat_answer(chat_answer)
	plan(plan)
	gate(gate)
	research(research)
	replan_check(replan_check)
	analysis(analysis)
	write(write)
	validate(validate)
	finalize(finalize)
	__end__([<p>__end__</p>]):::last
	__start__ --> route;
	analysis --> write;
	gate --> research;
	plan --> gate;
	replan_check -.-> analysis;
	replan_check -.-> research;
	research --> replan_check;
	route -.-> chat_answer;
	route -.-> plan;
	validate -.-> finalize;
	validate -.-> write;
	write --> validate;
	chat_answer --> __end__;
	finalize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
